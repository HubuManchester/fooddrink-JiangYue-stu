<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.Views.FoodDetailPage"
             x:Name="FoodDetailPageRoot"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Image Section -->
            <Frame Margin="0" Padding="0" CornerRadius="0" HasShadow="False" BackgroundColor="Transparent">
                <Image x:Name="FoodImage"
                       Source="{Binding FoodItem.ImageFileName}" 
                       Aspect="AspectFill"
                       HeightRequest="300">
                    <Image.GestureRecognizers>
                        <PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
                        <PanGestureRecognizer PanUpdated="OnPanUpdated"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <!-- Content Section -->
            <Frame Margin="0" Padding="0" CornerRadius="0" HasShadow="False" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D44}">
                <VerticalStackLayout Spacing="0">

                    <!-- Header Info -->
                    <VerticalStackLayout Padding="24,24,24,0" Spacing="0">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding FoodItem.Name}" 
                                   FontSize="{DynamicResource FontSizeTitle}" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"
                                   LineBreakMode="TailTruncation"/>
                            <Button Text="{Binding FoodItem.IsFavorite, Converter={StaticResource BoolToHeartConverter}}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{Binding FoodItem.IsFavorite, Converter={StaticResource BoolToColorConverter}}"
                                    FontSize="{DynamicResource FontSizeLarge}"
                                    WidthRequest="44" HeightRequest="44"
                                    Padding="0"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding FoodItem.Category}" 
                               FontSize="{DynamicResource FontSizeBody}" 
                               TextColor="#FF6B35"
                               Margin="0,6,0,0"/>
                    </VerticalStackLayout>

                    <!-- Stats Cards Row -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="20,16,20,0">
                        <!-- Rating Card -->
                        <Frame Grid.Column="0" CornerRadius="16" Padding="0" 
                               HasShadow="False" BackgroundColor="#FFF3E0" BorderColor="Transparent">
                            <VerticalStackLayout Padding="12,10" Spacing="4" HorizontalOptions="Center">
                                <Label Text="⭐" FontSize="{DynamicResource FontSizeSubtitle}" HorizontalOptions="Center"/>
                                <Label Text="{Binding FoodItem.Rating, StringFormat='{}{0:F1}'}" 
                                       FontSize="{DynamicResource FontSizeTitle}" FontAttributes="Bold" 
                                       TextColor="#FF6B35" HorizontalOptions="Center"/>
                                <Label Text="Rating" FontSize="{DynamicResource FontSizeMicro}" TextColor="#BF7B50" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Prep Time Card -->
                        <Frame Grid.Column="1" CornerRadius="16" Padding="0" 
                               HasShadow="False" BackgroundColor="#E3F2FD" BorderColor="Transparent">
                            <VerticalStackLayout Padding="12,10" Spacing="4" HorizontalOptions="Center">
                                <Label Text="⏱️" FontSize="{DynamicResource FontSizeSubtitle}" HorizontalOptions="Center"/>
                                <Label Text="{Binding FoodItem.PrepTimeMinutes, StringFormat='{}{0}'}" 
                                       FontSize="{DynamicResource FontSizeTitle}" FontAttributes="Bold" 
                                       TextColor="#1976D2" HorizontalOptions="Center"/>
                                <Label Text="min" FontSize="{DynamicResource FontSizeMicro}" TextColor="#64B5F6" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Calories Card -->
                        <Frame Grid.Column="2" CornerRadius="16" Padding="0" 
                               HasShadow="False" BackgroundColor="#E8F5E9" BorderColor="Transparent">
                            <VerticalStackLayout Padding="12,10" Spacing="4" HorizontalOptions="Center">
                                <Label Text="🔥" FontSize="{DynamicResource FontSizeSubtitle}" HorizontalOptions="Center"/>
                                <Label Text="{Binding FoodItem.Calories}" 
                                       FontSize="{DynamicResource FontSizeTitle}" FontAttributes="Bold" 
                                       TextColor="#388E3C" HorizontalOptions="Center"/>
                                <Label Text="kcal" FontSize="{DynamicResource FontSizeMicro}" TextColor="#81C784" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Origin Card -->
                        <Frame Grid.Column="3" CornerRadius="16" Padding="0" 
                               HasShadow="False" BackgroundColor="#F3E5F5" BorderColor="Transparent">
                            <VerticalStackLayout Padding="12,10" Spacing="4" HorizontalOptions="Center">
                                <Label Text="🌍" FontSize="{DynamicResource FontSizeSubtitle}" HorizontalOptions="Center"/>
                                <Label Text="{Binding FoodItem.Origin}" 
                                       FontSize="{DynamicResource FontSizeCaption}" FontAttributes="Bold" 
                                       TextColor="#7B1FA2" HorizontalOptions="Center"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="Origin" FontSize="{DynamicResource FontSizeMicro}" TextColor="#CE93D8" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Description Section -->
                    <VerticalStackLayout Padding="24,20,24,0" Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="4" CornerRadius="2" BackgroundColor="#FF6B35" VerticalOptions="Fill"/>
                            <Label Text="About this dish" FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding FoodItem.Description}" 
                               FontSize="{DynamicResource FontSizeBody}" LineBreakMode="WordWrap" 
                               TextColor="{AppThemeBinding Light=#495057, Dark=#ADB5BD}" LineHeight="1.5"/>
                    </VerticalStackLayout>

                    <!-- Details Section -->
                    <VerticalStackLayout Padding="24,20,24,0" Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="4" CornerRadius="2" BackgroundColor="#2196F3" VerticalOptions="Fill"/>
                            <Label Text="Cooking Tips &amp; History" FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                        </HorizontalStackLayout>
                        <Frame CornerRadius="16" Padding="16" 
                               HasShadow="False" 
                               BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#1A2744}" 
                               BorderColor="Transparent">
                            <Label Text="{Binding FoodItem.Details}" 
                                   FontSize="{DynamicResource FontSizeBody}" LineBreakMode="WordWrap" 
                                   TextColor="{AppThemeBinding Light=#34495E, Dark=#ADB5BD}" LineHeight="1.6"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Ingredients Section -->
                    <VerticalStackLayout Padding="24,20,24,0" Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="4" CornerRadius="2" BackgroundColor="#4CAF50" VerticalOptions="Fill"/>
                            <Label Text="Ingredients" FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                        </HorizontalStackLayout>
                        <Frame CornerRadius="16" Padding="12" 
                               HasShadow="False" 
                               BackgroundColor="{AppThemeBinding Light=#F1F8E9, Dark=#1A2E1A}" 
                               BorderColor="Transparent">
                            <CollectionView ItemsSource="{Binding FoodItem.Ingredients}" 
                                            SelectionMode="None" 
                                            BackgroundColor="Transparent"
                                            Margin="0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <HorizontalStackLayout Spacing="12" Padding="4,0">
                                            <Label Text="•" FontSize="{DynamicResource FontSizeSubtitle}" TextColor="#4CAF50" VerticalOptions="Center"/>
                                            <Label Text="{Binding}" 
                                                   FontSize="{DynamicResource FontSizeBody}" 
                                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <VerticalStackLayout Padding="24,24,24,20" Spacing="12">
                        <Button Text="📷  Take a Photo" 
                                Clicked="OnCameraClicked"
                                BackgroundColor="#FF6B35" 
                                TextColor="White"
                                FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold"
                                HeightRequest="52" CornerRadius="16"
                                Padding="0"/>

                        <Button Text="📍  Find Nearby Restaurants" 
                                Clicked="OnLocationClicked"
                                BackgroundColor="#2196F3" 
                                TextColor="White"
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                HeightRequest="52" CornerRadius="16"
                                Padding="0"/>

                        <Button Text="🔊  Read Recipe Aloud" 
                                Clicked="OnSpeakClicked"
                                BackgroundColor="#9C27B0" 
                                TextColor="White"
                                FontSize="{DynamicResource FontSizeSubtitle}"
                                HeightRequest="52" CornerRadius="16"
                                Padding="0"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
