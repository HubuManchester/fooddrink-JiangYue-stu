<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             xmlns:converters="clr-namespace:FoodDrinkApp.Converters"
             xmlns:controls="clr-namespace:FoodDrinkApp.Controls"
             x:Class="FoodDrinkApp.Views.HomePage"
             x:Name="HomePageRoot"
             BackgroundColor="{DynamicResource BackgroundColor}"
             Padding="0"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToHeartConverter x:Key="BoolToHeartConverter"/>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section with Orange Background -->
        <Frame Grid.Row="0" Margin="0" Padding="0" CornerRadius="0" HasShadow="False" BackgroundColor="{DynamicResource CurrentPrimaryColor}">
            <VerticalStackLayout Padding="20,40,20,30" Spacing="12">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="🍽️" FontSize="40" VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Food Finder" FontSize="28" FontAttributes="Bold" 
                               TextColor="White" LineHeight="1.1"/>
                        <Label Text="Discover delicious recipes" FontSize="14" 
                               TextColor="{DynamicResource CardColor}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Search Control -->
        <Frame Grid.Row="1" Margin="20,0,20,0" Padding="0" CornerRadius="24" HasShadow="True">
            <controls:SearchBarControl SearchText="{Binding SearchText}"
                                  ClearCommand="{Binding ClearSearchCommand}"
                                  Placeholder="Search food, cuisine..."/>
        </Frame>

        <!-- Search Validation Message -->
        <Frame Grid.Row="2" Margin="20,12,20,0" Padding="12" CornerRadius="12" HasShadow="False"
               BackgroundColor="#FFEBEE" BorderColor="#FFCDD2"
               IsVisible="{Binding HasError}">
            <HorizontalStackLayout Spacing="8">
                <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}" 
                       TextColor="#D32F2F" 
                       FontSize="14" 
                       VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"/>
                <Button Text="✕" 
                        Command="{Binding DismissErrorCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#D32F2F"
                        FontSize="16"
                        Padding="0"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Accelerometer Display Card -->
        <Frame Grid.Row="3" Margin="20,12,20,8" CornerRadius="12" HasShadow="False" 
               BackgroundColor="{AppThemeBinding Light=#FCE4EC, Dark=#1A1020}" 
               BorderColor="{AppThemeBinding Light=#F8BBD9, Dark=#3D2040}"
               IsVisible="{Binding IsAccelerometerActive}"
               Padding="12">
            <Grid ColumnDefinitions="*,*,*,Auto">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="X" FontSize="{DynamicResource FontSizeCaption}" TextColor="#E91E63" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding AccelerometerX, StringFormat='{}{0:F2}'}" 
                           FontSize="{DynamicResource FontSizeBody}" TextColor="#E91E63" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Y" FontSize="{DynamicResource FontSizeCaption}" TextColor="#9C27B0" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding AccelerometerY, StringFormat='{}{0:F2}'}" 
                           FontSize="{DynamicResource FontSizeBody}" TextColor="#9C27B0" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="Z" FontSize="{DynamicResource FontSizeCaption}" TextColor="#673AB7" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding AccelerometerZ, StringFormat='{}{0:F2}'}" 
                           FontSize="{DynamicResource FontSizeBody}" TextColor="#673AB7" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Button Grid.Column="3" Text="Stop" 
                        Command="{Binding ToggleAccelerometerCommand}"
                        BackgroundColor="#E91E63" TextColor="White"
                        FontSize="{DynamicResource FontSizeCaption}"
                        WidthRequest="72" HeightRequest="32" CornerRadius="16"
                        VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Category Filter Buttons -->
        <ScrollView Grid.Row="4" Orientation="Horizontal" Margin="20,12" HorizontalScrollBarVisibility="Never">
            <FlexLayout Direction="Row" Wrap="NoWrap" AlignItems="Center" Margin="0,0,0,12">
                <Button Text="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                        BackgroundColor="{DynamicResource CurrentPrimaryColor}" TextColor="White" 
                        CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" Padding="16,0" FontAttributes="Bold"/>
                <Button Text="Appetizer" Command="{Binding SelectCategoryCommand}" CommandParameter="Appetizer"
                        BackgroundColor="{DynamicResource CardColor}" 
                        TextColor="{DynamicResource TextSecondaryColor}" 
                        CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="{DynamicResource BorderColor}" BorderWidth="1"/>
                <Button Text="Main Course" Command="{Binding SelectCategoryCommand}" CommandParameter="Main Course"
                        BackgroundColor="{DynamicResource CardColor}" 
                        TextColor="{DynamicResource TextSecondaryColor}" 
                        CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="{DynamicResource BorderColor}" BorderWidth="1"/>
                <Button Text="Dessert" Command="{Binding SelectCategoryCommand}" CommandParameter="Dessert"
                        BackgroundColor="{DynamicResource CardColor}" 
                        TextColor="{DynamicResource TextSecondaryColor}" 
                        CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="{DynamicResource BorderColor}" BorderWidth="1"/>
                <Button Text="Drinks" Command="{Binding SelectCategoryCommand}" CommandParameter="Drink"
                        BackgroundColor="{DynamicResource CardColor}" 
                        TextColor="{DynamicResource TextSecondaryColor}" 
                        CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="{DynamicResource BorderColor}" BorderWidth="1"/>
                <Button Text="Snacks" Command="{Binding SelectCategoryCommand}" CommandParameter="Snack"
                        BackgroundColor="{DynamicResource CardColor}" 
                        TextColor="{DynamicResource TextSecondaryColor}" 
                        CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="{DynamicResource BorderColor}" BorderWidth="1"/>
                <Button Text="❤️ Favorites" Command="{Binding ToggleShowFavoritesCommand}"
                        BackgroundColor="{Binding ShowOnlyFavorites, Converter={StaticResource BoolToColorConverter}}"
                        TextColor="White" CornerRadius="20" HeightRequest="36" FontSize="{DynamicResource FontSizeCaption}" 
                        Padding="16,0" Margin="8,0,0,0"/>
            </FlexLayout>
        </ScrollView>

        <!-- Food List -->
        <CollectionView Grid.Row="5" 
                    ItemsSource="{Binding FilteredItems}" 
                    SelectionMode="None" 
                    BackgroundColor="Transparent" 
                    Margin="20,0,20,20">
            <CollectionView.EmptyView>
                <Frame BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#2D2D44}" 
                       CornerRadius="20" 
                       Padding="30" 
                       Margin="10"
                       HasShadow="True">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                        <Label Text="🔍" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="No items found" FontSize="20" FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#F8F9FA}" 
                               HorizontalOptions="Center"/>
                        <Label Text="Try adjusting your search or filters" FontSize="15" 
                               TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FoodItem">
                    <SwipeView Margin="0,0,0,16">
                        <SwipeView.LeftItems>
                            <SwipeItem Text="Delete" 
                                       BackgroundColor="#F44336"
                                       Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.DeleteItemCommand}"
                                       CommandParameter="{Binding .}"
                                       IsVisible="True"/>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItem Text="Favorite" 
                                       BackgroundColor="#FF9800"
                                       Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.SwipeFavoriteCommand}"
                                       CommandParameter="{Binding .}"/>
                            <SwipeItem Text="Share" 
                                       BackgroundColor="#2196F3"
                                       Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ShareItemCommand}"
                                       CommandParameter="{Binding .}"/>
                        </SwipeView.RightItems>
                        <Frame CornerRadius="20" HasShadow="True" Padding="14" 
                               BackgroundColor="{DynamicResource CardColor}" 
                               BorderColor="{DynamicResource BorderColor}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="100,*,60">
                                <Frame Grid.Column="0" 
                                       WidthRequest="100" HeightRequest="100" 
                                       CornerRadius="16" 
                                       IsClippedToBounds="True"
                                       Padding="0"
                                       BackgroundColor="{DynamicResource BackgroundColor}">
                                    <Image Source="{Binding ImageFileName}" Aspect="AspectFill"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Margin="14,4,0,4" Spacing="8">
                                    <Label Text="{Binding Name}" FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold" 
                                           TextColor="{DynamicResource TextPrimaryColor}" LineBreakMode="TailTruncation"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="⭐" FontSize="{DynamicResource FontSizeCaption}"/>
                                        <Label Text="{Binding Rating, StringFormat='{}{0:F1}'}" FontSize="{DynamicResource FontSizeCaption}" TextColor="{DynamicResource CurrentPrimaryColor}" FontAttributes="Bold"/>
                                        <Label Text="•" FontSize="{DynamicResource FontSizeCaption}" TextColor="{DynamicResource TextSecondaryColor}"/>
                                        <Label Text="{Binding Origin}" FontSize="{DynamicResource FontSizeCaption}" TextColor="{DynamicResource TextSecondaryColor}"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Description}" FontSize="{DynamicResource FontSizeBody}" 
                                           TextColor="{DynamicResource TextSecondaryColor}" LineBreakMode="TailTruncation" MaxLines="2"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="{Binding IsFavorite, Converter={StaticResource BoolToHeartConverter}}"
                                        Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="{Binding IsFavorite, Converter={StaticResource BoolToColorConverter}}"
                                        FontSize="{DynamicResource FontSizeLarge}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        Padding="0"/>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Overlay -->
        <Frame Grid.RowSpan="6" 
               BackgroundColor="{DynamicResource BackgroundColor}" 
               Opacity="0.8"
               Padding="0" 
               IsVisible="{Binding IsLoading}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                <controls:LoadingControl IsLoading="{Binding IsLoading}" 
                                    LoadingText="{Binding LoadingText}"/>
            </VerticalStackLayout>
        </Frame>

        <!-- ========== Floating Action Buttons ========== -->

        <!-- Menu items -->
        <VerticalStackLayout Grid.RowSpan="6" 
                             HorizontalOptions="End" 
                             VerticalOptions="End" 
                             Margin="0,0,20,190" 
                             Spacing="12" 
                             IsVisible="{Binding IsMenuOpen}"
                             ZIndex="100">

            <Button Text="📍 GPS" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#4CAF50" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding GetNearbyLocationCommand}"
                    HorizontalOptions="End"/>

            <Button Text="📷 Camera" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#2196F3" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding TakePhotoCommand}"
                    HorizontalOptions="End"/>

            <Button Text="🔊 Read" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#9C27B0" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding SpeakRecipeCommand}"
                    HorizontalOptions="End"/>

            <Button Text="✨ Vibrate" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#FF9800" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding VibrateCommand}"
                    HorizontalOptions="End"/>

            <Button Text="🔦 Flashlight" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#FF5722" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding ToggleFlashlightCommand}"
                    HorizontalOptions="End"/>

            <Button Text="🔄 Refresh" 
                    WidthRequest="160" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#8BC34A" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding RefreshDataCommand}"
                    HorizontalOptions="End"/>

            <Button Text="📱 Accelerometer" 
                    WidthRequest="160" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#E91E63" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding ToggleAccelerometerCommand}"
                    HorizontalOptions="End"
                    Padding="10,0"/>
        </VerticalStackLayout>

        <!-- Main FAB button -->
        <Button Grid.RowSpan="6"
                HorizontalOptions="End" 
                VerticalOptions="End"
                Margin="0,0,20,120"
                WidthRequest="64" HeightRequest="64" 
                CornerRadius="32"
                BackgroundColor="{DynamicResource CurrentPrimaryColor}" 
                TextColor="White" 
                FontSize="{DynamicResource FontSizeLarge}"
                Command="{Binding ToggleMenuCommand}"
                ZIndex="200"
                Padding="0">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsMenuOpen}" Value="True">
                    <Setter Property="Text" Value="✕"/>
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Text" Value="⚡"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentPage>
