<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             xmlns:converters="clr-namespace:FoodDrinkApp.Converters"
             x:Class="FoodDrinkApp.Views.HomePage"
             x:Name="HomePageRoot"
             Title="Food Finder"
             BackgroundColor="#F8F9FA"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToHeartConverter x:Key="BoolToHeartConverter"/>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Frame Grid.Row="0" Margin="16,12,16,8" Padding="4" CornerRadius="16" HasShadow="True" BackgroundColor="White" BorderColor="#E9ECEF">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Text="🔍" FontSize="18" VerticalOptions="Center" Margin="12,0"/>
                <Entry Grid.Column="1" 
                       Placeholder="Search food, cuisine..." 
                       Text="{Binding SearchText}" 
                       FontSize="15" 
                       VerticalOptions="Center" 
                       BackgroundColor="Transparent"/>
                <Button Grid.Column="2" 
                        Text="✖" 
                        Command="{Binding ClearSearchCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#ADB5BD"
                        FontSize="14"
                        WidthRequest="40"
                        IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmptyConverter}}"/>
            </Grid>
        </Frame>

        <!-- Category Filter Buttons -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="16,0" HorizontalScrollBarVisibility="Never">
            <FlexLayout Direction="Row" Wrap="NoWrap" AlignItems="Center" Margin="0,0,0,8">
                <Button Text="All" Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                        BackgroundColor="#FF6B35" TextColor="White" 
                        CornerRadius="20" HeightRequest="36" FontSize="13" Padding="16,0" FontAttributes="Bold"/>
                <Button Text="Appetizer" Command="{Binding SelectCategoryCommand}" CommandParameter="Appetizer"
                        BackgroundColor="#F8F9FA" TextColor="#495057" 
                        CornerRadius="20" HeightRequest="36" FontSize="13" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="#DEE2E6" BorderWidth="1"/>
                <Button Text="Main Course" Command="{Binding SelectCategoryCommand}" CommandParameter="Main Course"
                        BackgroundColor="#F8F9FA" TextColor="#495057" 
                        CornerRadius="20" HeightRequest="36" FontSize="13" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="#DEE2E6" BorderWidth="1"/>
                <Button Text="Dessert" Command="{Binding SelectCategoryCommand}" CommandParameter="Dessert"
                        BackgroundColor="#F8F9FA" TextColor="#495057" 
                        CornerRadius="20" HeightRequest="36" FontSize="13" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="#DEE2E6" BorderWidth="1"/>
                <Button Text="Drinks" Command="{Binding SelectCategoryCommand}" CommandParameter="Drink"
                        BackgroundColor="#F8F9FA" TextColor="#495057" 
                        CornerRadius="20" HeightRequest="36" FontSize="13" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="#DEE2E6" BorderWidth="1"/>
                <Button Text="Snacks" Command="{Binding SelectCategoryCommand}" CommandParameter="Snack"
                        BackgroundColor="#F8F9FA" TextColor="#495057" 
                        CornerRadius="20" HeightRequest="36" FontSize="13" Padding="16,0" 
                        Margin="8,0,0,0" BorderColor="#DEE2E6" BorderWidth="1"/>
                <Button Text="❤️ Favorites" Command="{Binding ToggleShowFavoritesCommand}"
                        BackgroundColor="{Binding ShowOnlyFavorites, Converter={StaticResource BoolToColorConverter}}"
                        TextColor="White" CornerRadius="20" HeightRequest="36" FontSize="13" 
                        Padding="16,0" Margin="8,0,0,0"/>
            </FlexLayout>
        </ScrollView>

        <!-- Food List -->
        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding FilteredItems}" 
                        SelectionMode="None" 
                        BackgroundColor="Transparent" 
                        Margin="16,8,16,16">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <Label Text="🍽️" FontSize="64" HorizontalOptions="Center"/>
                    <Label Text="No items found" FontSize="18" FontAttributes="Bold" TextColor="#6C757D" HorizontalOptions="Center"/>
                    <Label Text="Try adjusting your search or filters" FontSize="14" TextColor="#ADB5BD" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FoodItem">
                    <Frame CornerRadius="16" HasShadow="True" Margin="0,0,0,12" Padding="14" BackgroundColor="White" BorderColor="#F1F3F5">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="80,*,56">
                            <Frame Grid.Column="0" 
                                   WidthRequest="80" HeightRequest="80" 
                                   CornerRadius="12" 
                                   IsClippedToBounds="True"
                                   Padding="0"
                                   BackgroundColor="#F8F9FA">
                                <Image Source="{Binding ImageFileName}" Aspect="AspectFill"/>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" Spacing="6">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" TextColor="#1A1A2E" LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="⭐" FontSize="12"/>
                                    <Label Text="{Binding Rating, StringFormat='{}{0:F1}'}" FontSize="13" TextColor="#FF6B35" FontAttributes="Bold"/>
                                    <Label Text="•" FontSize="13" TextColor="#ADB5BD"/>
                                    <Label Text="{Binding Origin}" FontSize="13" TextColor="#6C757D"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Description}" FontSize="13" TextColor="#ADB5BD" LineBreakMode="TailTruncation" MaxLines="2"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="{Binding IsFavorite, Converter={StaticResource BoolToHeartConverter}}"
                                    Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="{Binding IsFavorite, Converter={StaticResource BoolToColorConverter}}"
                                    FontSize="28"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    Padding="0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ========== FLOATING ACTION BUTTONS ========== -->

        <!-- Menu items -->
        <VerticalStackLayout Grid.RowSpan="3" 
                             HorizontalOptions="End" 
                             VerticalOptions="End" 
                             Margin="0,0,20,170" 
                             Spacing="12" 
                             IsVisible="{Binding IsMenuOpen}"
                             ZIndex="100">

            <Button Text="📍 GPS" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#4CAF50" TextColor="White" FontSize="14"
                    Command="{Binding GetNearbyLocationCommand}"
                    HorizontalOptions="End"/>

            <Button Text="📷 Camera" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#2196F3" TextColor="White" FontSize="14"
                    Command="{Binding TakePhotoCommand}"
                    HorizontalOptions="End"/>

            <Button Text="🔊 Read" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#9C27B0" TextColor="White" FontSize="14"
                    Command="{Binding SpeakRecipeCommand}"
                    HorizontalOptions="End"/>

            <Button Text="✨ Vibrate" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#FF9800" TextColor="White" FontSize="14"
                    Command="{Binding VibrateCommand}"
                    HorizontalOptions="End"/>
        </VerticalStackLayout>

        <!-- Main FAB button -->
        <Button Grid.RowSpan="3"
                HorizontalOptions="End" 
                VerticalOptions="End"
                Margin="0,0,20,100"
                WidthRequest="60" HeightRequest="60" 
                CornerRadius="30"
                BackgroundColor="#FF6B35" 
                TextColor="White" 
                FontSize="26"
                Command="{Binding ToggleMenuCommand}"
                ZIndex="200"
                Padding="0">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsMenuOpen}" Value="True">
                    <Setter Property="Text" Value="✕"/>
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Text" Value="⚡"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>

    </Grid>
</ContentPage>