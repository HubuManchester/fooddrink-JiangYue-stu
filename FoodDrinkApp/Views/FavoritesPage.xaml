<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             xmlns:converters="clr-namespace:FoodDrinkApp.Converters"
             x:Class="FoodDrinkApp.Views.FavoritesPage"
             x:Name="FavoritesPageRoot"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             Padding="0"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToHeartConverter x:Key="BoolToHeartConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== BEAUTIFUL HEADER SECTION ========== -->
        <Frame Grid.Row="0" Margin="0" Padding="0" CornerRadius="0" HasShadow="False"
               BackgroundColor="{AppThemeBinding Light=#FF4757, Dark=#FF4757}">
            <VerticalStackLayout Padding="24,48,24,24" Spacing="16">
                <!-- Title -->
                <HorizontalStackLayout Spacing="12">
                    <Label Text="❤️" FontSize="40" VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="My Favorites" FontSize="28" FontAttributes="Bold" 
                               TextColor="White" LineHeight="1.1"/>
                        <Label Text="Saved delicious recipes" FontSize="14" 
                               TextColor="#FFE6EA"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                
                <!-- Favorite Count -->
                <Frame Margin="0" Padding="12,8" CornerRadius="16" HasShadow="False" 
                       BackgroundColor="#FFFFFF44">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="💝" FontSize="20" VerticalOptions="Center"/>
                        <Label Text="{Binding FilteredItems.Count, StringFormat='{0} favorites saved'}" 
                               FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </Frame>

        <!-- Favorites List -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding FilteredItems}" 
                        SelectionMode="None" 
                        BackgroundColor="Transparent" 
                        Margin="16,8">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <Label Text="💝" FontSize="{DynamicResource FontSizeHuge}" HorizontalOptions="Center"/>
                    <Label Text="No favorites yet" FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" HorizontalOptions="Center"/>
                    <Label Text="Go to Home page and tap the heart icon on any food item to add it to your favorites" 
                           FontSize="{DynamicResource FontSizeBody}" 
                           TextColor="{AppThemeBinding Light=#ADB5BD, Dark=#6C757D}" HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" Margin="32,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FoodItem">
                    <Frame CornerRadius="16" HasShadow="True" Margin="0,0,0,12" Padding="14" 
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D44}" 
                           BorderColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="80,*,56">
                            <Frame Grid.Column="0" 
                                   WidthRequest="80" HeightRequest="80" 
                                   CornerRadius="12" 
                                   IsClippedToBounds="True"
                                   Padding="0"
                                   BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1A1A2E}">
                                <Image Source="{Binding ImageFileName}" Aspect="AspectFill"/>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" Spacing="6">
                                <Label Text="{Binding Name}" FontSize="{DynamicResource FontSizeSubtitle}" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}" LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="⭐" FontSize="{DynamicResource FontSizeCaption}"/>
                                    <Label Text="{Binding Rating, StringFormat='{}{0:F1}'}" FontSize="{DynamicResource FontSizeCaption}" TextColor="#FF6B35" FontAttributes="Bold"/>
                                    <Label Text="•" FontSize="{DynamicResource FontSizeCaption}" TextColor="{AppThemeBinding Light=#ADB5BD, Dark=#6C757D}"/>
                                    <Label Text="{Binding Origin}" FontSize="{DynamicResource FontSizeCaption}" TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#ADB5BD, Dark=#6C757D}" LineBreakMode="TailTruncation" MaxLines="2"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="❤️"
                                    Command="{Binding Source={x:Reference FavoritesPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="#FF4757"
                                    FontSize="{DynamicResource FontSizeLarge}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    Padding="0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ========== FLOATING ACTION BUTTONS ========== -->

        <!-- Menu items -->
        <VerticalStackLayout Grid.RowSpan="2" 
                             HorizontalOptions="End" 
                             VerticalOptions="End" 
                             Margin="0,0,20,170" 
                             Spacing="12" 
                             IsVisible="{Binding IsMenuOpen}"
                             ZIndex="100">

            <Button Text="📍 GPS" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#4CAF50" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding GetNearbyLocationCommand}"
                    HorizontalOptions="End"/>

            <Button Text="📷 Camera" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#2196F3" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding TakePhotoCommand}"
                    HorizontalOptions="End"/>

            <Button Text="🔊 Read" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#9C27B0" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding SpeakRecipeCommand}"
                    HorizontalOptions="End"/>

            <Button Text="✨ Vibrate" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#FF9800" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding VibrateCommand}"
                    HorizontalOptions="End"/>

            <Button Text="📱 Accelerometer" 
                    WidthRequest="140" HeightRequest="44" CornerRadius="22"
                    BackgroundColor="#E91E63" TextColor="White" FontSize="{DynamicResource FontSizeBody}"
                    Command="{Binding ToggleAccelerometerCommand}"
                    HorizontalOptions="End"/>
        </VerticalStackLayout>

        <!-- Main FAB button -->
        <Button Grid.RowSpan="2"
                HorizontalOptions="End" 
                VerticalOptions="End"
                Margin="0,0,20,100"
                WidthRequest="60" HeightRequest="60" 
                CornerRadius="30"
                BackgroundColor="#FF4757" 
                TextColor="White" 
                FontSize="{DynamicResource FontSizeLarge}"
                Command="{Binding ToggleMenuCommand}"
                ZIndex="200"
                Padding="0">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsMenuOpen}" Value="True">
                    <Setter Property="Text" Value="✕"/>
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Text" Value="⚡"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>

    </Grid>
</ContentPage>
