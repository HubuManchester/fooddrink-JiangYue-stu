<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="#F8F9FA"
             Padding="0">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,16,16,24">

            <!-- ========== APPEARANCE SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="🎨 APPEARANCE" 
                       FontSize="12" FontAttributes="Bold" 
                       TextColor="#FF6B35" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="White" BorderColor="Transparent">
                    <VerticalStackLayout>

                        <!-- Dark Mode -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="🌙 Dark Mode" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Switch between light and dark themes" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch x:Name="DarkModeSwitch" 
                                    Grid.Column="1" 
                                    VerticalOptions="Center"
                                    OnColor="#FF6B35"
                                    ThumbColor="White"
                                    Toggled="OnDarkModeToggled"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <!-- Font Size -->
                        <VerticalStackLayout Padding="18,14" Spacing="10">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔤 Font Size" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Frame CornerRadius="10" Padding="6,2" HasShadow="False" 
                                       BackgroundColor="#FFF3E0" BorderColor="Transparent">
                                    <Label x:Name="FontSizeLabel" 
                                           Text="Medium" 
                                           FontSize="11" FontAttributes="Bold" 
                                           TextColor="#FF6B35"/>
                                </Frame>
                            </HorizontalStackLayout>
                            <Label Text="Adjust the text size throughout the app" FontSize="12" TextColor="#6C757D"/>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                <Label Text="A" FontSize="14" TextColor="#ADB5BD" VerticalOptions="Center"/>
                                <Slider x:Name="FontSizeSlider" 
                                        Grid.Column="1"
                                        Minimum="0.8" Maximum="1.5" Value="1.0"
                                        MinimumTrackColor="#FF6B35"
                                        MaximumTrackColor="#E9ECEF"
                                        ThumbColor="#FF6B35"
                                        ValueChanged="OnFontSizeChanged"
                                        Margin="12,0"/>
                                <Label Grid.Column="2" Text="A" FontSize="20" FontAttributes="Bold" 
                                       TextColor="#FF6B35" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ========== ACCESSIBILITY SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="♿ ACCESSIBILITY" 
                       FontSize="12" FontAttributes="Bold" 
                       TextColor="#2196F3" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="White" BorderColor="Transparent">
                    <VerticalStackLayout>

                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="🔊 Screen Reader" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Enable voice feedback for recipes" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#2196F3" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="👁️ High Contrast" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Increase color contrast for readability" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#2196F3" ThumbColor="White"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ========== HARDWARE SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="📱 HARDWARE FEATURES" 
                       FontSize="12" FontAttributes="Bold" 
                       TextColor="#4CAF50" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="White" BorderColor="Transparent">
                    <VerticalStackLayout>

                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="📷 Camera" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Food photo recognition" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="📍 Location" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Find nearby restaurants" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="🎤 Microphone" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Voice commands support" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="📳 Vibration" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"/>
                                <Label Text="Haptic feedback on actions" FontSize="12" TextColor="#6C757D" Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ========== ABOUT SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="ℹ️ ABOUT" 
                       FontSize="12" FontAttributes="Bold" 
                       TextColor="#9C27B0" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="White" BorderColor="Transparent">
                    <VerticalStackLayout>

                        <Grid Padding="18,14" ColumnDefinitions="*,*">
                            <Label Text="App Version" FontSize="16" TextColor="#1A1A2E" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="1.0.0" 
                                   HorizontalOptions="End" FontSize="16" FontAttributes="Bold" 
                                   TextColor="#FF6B35" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <Grid Padding="18,14" ColumnDefinitions="*,*">
                            <Label Text="Developer" FontSize="16" TextColor="#1A1A2E" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Mobile Computing" 
                                   HorizontalOptions="End" FontSize="16" FontAttributes="Bold" 
                                   TextColor="#9C27B0" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F1F3F5" Margin="18,0"/>

                        <Grid Padding="18,14" ColumnDefinitions="*,*">
                            <Label Text="Made with" FontSize="16" TextColor="#1A1A2E" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="❤️ .NET MAUI" 
                                   HorizontalOptions="End" FontSize="16" FontAttributes="Bold" 
                                   TextColor="#FF4757" VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>