<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.Views.SettingsPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             Padding="0">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,16,16,24">

            <!-- ========== APPEARANCE SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="🎨 APPEARANCE" 
                       FontSize="{DynamicResource FontSizeCaption}" 
                       FontAttributes="Bold" 
                       TextColor="#FF6B35" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D44}" 
                       BorderColor="Transparent">
                    <VerticalStackLayout>

                        <!-- Dark Mode -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="🌙 Dark Mode" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Switch between light and dark themes" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch x:Name="DarkModeSwitch" 
                                    Grid.Column="1" 
                                    VerticalOptions="Center"
                                    OnColor="#FF6B35"
                                    ThumbColor="White"
                                    Toggled="OnDarkModeToggled"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- Font Size -->
                        <VerticalStackLayout Padding="18,14" Spacing="10">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔤 Font Size" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Frame CornerRadius="10" Padding="6,2" HasShadow="False" 
                                       BackgroundColor="#FFF3E0" BorderColor="Transparent">
                                    <Label x:Name="FontSizeLabel" 
                                           Text="Medium" 
                                           FontSize="{DynamicResource FontSizeCaption}" 
                                           FontAttributes="Bold" 
                                           TextColor="#FF6B35"/>
                                </Frame>
                            </HorizontalStackLayout>
                            <Label Text="Adjust the text size throughout the app" 
                                   FontSize="{DynamicResource FontSizeCaption}" 
                                   TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}"/>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                <Label Text="A" 
                                       FontSize="{DynamicResource FontSizeBody}" 
                                       TextColor="{AppThemeBinding Light=#ADB5BD, Dark=#6C757D}" 
                                       VerticalOptions="Center"/>
                                <Slider x:Name="FontSizeSlider" 
                                        Grid.Column="1"
                                        Minimum="0.8" Maximum="1.5" Value="1.0"
                                        MinimumTrackColor="#FF6B35"
                                        MaximumTrackColor="#E9ECEF"
                                        ThumbColor="#FF6B35"
                                        ValueChanged="OnFontSizeChanged"
                                        Margin="12,0"/>
                                <Label Grid.Column="2" Text="A" 
                                       FontSize="{DynamicResource FontSizeTitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="#FF6B35" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ========== ACCESSIBILITY SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="♿ ACCESSIBILITY" 
                       FontSize="{DynamicResource FontSizeCaption}" 
                       FontAttributes="Bold" 
                       TextColor="#2196F3" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D44}" 
                       BorderColor="Transparent">
                    <VerticalStackLayout>

                        <!-- Screen Reader -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="🔊 Screen Reader Support" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Enable voice feedback for recipes" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#2196F3" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- High Contrast -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="👁️ High Contrast Mode" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Increase color contrast for readability" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch x:Name="HighContrastSwitch" Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#2196F3" ThumbColor="White"
                                    Toggled="OnHighContrastToggled"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ========== HARDWARE FEATURES SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="📱 HARDWARE FEATURES" 
                       FontSize="{DynamicResource FontSizeCaption}" 
                       FontAttributes="Bold" 
                       TextColor="#4CAF50" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D44}" 
                       BorderColor="Transparent">
                    <VerticalStackLayout>

                        <!-- Camera -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="📷 Camera" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Food photo recognition" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- Location -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="📍 Location" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Find nearby restaurants" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- Microphone -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="🎤 Microphone" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Voice commands support" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- Vibration -->
                        <Grid Padding="18,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="📳 Vibration" 
                                       FontSize="{DynamicResource FontSizeSubtitle}" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}"/>
                                <Label Text="Haptic feedback on actions" 
                                       FontSize="{DynamicResource FontSizeCaption}" 
                                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" 
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" VerticalOptions="Center"
                                    OnColor="#4CAF50" ThumbColor="White"
                                    IsToggled="True"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ========== ABOUT SECTION ========== -->
            <VerticalStackLayout Spacing="4">
                <Label Text="ℹ️ ABOUT" 
                       FontSize="{DynamicResource FontSizeCaption}" 
                       FontAttributes="Bold" 
                       TextColor="#9C27B0" 
                       CharacterSpacing="2"
                       Margin="4,0,0,4"/>

                <Frame CornerRadius="20" HasShadow="True" Padding="0" 
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D44}" 
                       BorderColor="Transparent">
                    <VerticalStackLayout>

                        <!-- App Version -->
                        <Grid Padding="18,14" ColumnDefinitions="*,*">
                            <Label Text="App Version" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}" 
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="1.0.0" 
                                   HorizontalOptions="End" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   FontAttributes="Bold" 
                                   TextColor="#FF6B35" 
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- Developer -->
                        <Grid Padding="18,14" ColumnDefinitions="*,*">
                            <Label Text="Developer" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}" 
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Mobile Computing" 
                                   HorizontalOptions="End" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   FontAttributes="Bold" 
                                   TextColor="#9C27B0" 
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#3D3D5C}" 
                                 Margin="18,0"/>

                        <!-- Made with -->
                        <Grid Padding="18,14" ColumnDefinitions="*,*">
                            <Label Text="Made with" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#F8F9FA}" 
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="❤️ .NET MAUI" 
                                   HorizontalOptions="End" 
                                   FontSize="{DynamicResource FontSizeSubtitle}" 
                                   FontAttributes="Bold" 
                                   TextColor="#FF4757" 
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
