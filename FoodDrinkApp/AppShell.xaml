<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="FoodDrinkApp.AppShell" 
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
       xmlns:views="clr-namespace:FoodDrinkApp.Views" 
       Shell.FlyoutBehavior="Disabled" 
       Shell.NavBarHasShadow="True"
       Shell.NavBarIsVisible="True"
       Title="Food Drink App">

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent Route="HomePage" ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Favorites" Icon="heart.png">
            <ShellContent Route="FavoritesPage" ContentTemplate="{DataTemplate views:FavoritesPage}" />
        </Tab>
        <Tab Title="Settings" Icon="settings.png">
            <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>