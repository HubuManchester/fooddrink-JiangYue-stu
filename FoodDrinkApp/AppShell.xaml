<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="FoodDrinkApp.AppShell" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:FoodDrinkApp.Views" xmlns:converters="clr-namespace:FoodDrinkApp.Converters" Shell.FlyoutBehavior="Disabled" Shell.NavBarHasShadow="True" Title="Food Drink App">
    <Shell.Resources>
        <converters:BoolToFavoriteConverter x:Key="BoolToFavoriteConverter"/>
    </Shell.Resources>
    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent Route="HomePage"><ShellContent.ContentTemplate><DataTemplate><views:HomePage/></DataTemplate></ShellContent.ContentTemplate></ShellContent>
        </Tab>
        <Tab Title="Favorites" Icon="heart.png">
            <ShellContent Route="FavoritesPage"><ShellContent.ContentTemplate><DataTemplate><views:HomePage/></DataTemplate></ShellContent.ContentTemplate></ShellContent>
        </Tab>
        <Tab Title="Settings" Icon="settings.png">
            <ShellContent Route="SettingsPage"><ShellContent.ContentTemplate><DataTemplate><views:SettingsPage/></DataTemplate></ShellContent.ContentTemplate></ShellContent>
        </Tab>
    </TabBar>
</Shell>
