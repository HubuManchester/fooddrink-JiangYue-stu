<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="FoodDrinkApp.AppShell" 
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FoodDrinkApp.Views"
       Shell.FlyoutBehavior="Disabled" 
       Shell.NavBarHasShadow="True"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="{DynamicResource CardColor}"
       Shell.ForegroundColor="{DynamicResource CurrentPrimaryColor}"
       Shell.TitleColor="{DynamicResource TextPrimaryColor}"
       Shell.UnselectedColor="{DynamicResource TextSecondaryColor}"
       Shell.TabBarBackgroundColor="{DynamicResource CardColor}"
       Shell.TabBarForegroundColor="{DynamicResource CurrentPrimaryColor}"
       Shell.TabBarUnselectedColor="{DynamicResource TextSecondaryColor}"
       Title="Food Finder">

    <!-- ========== Bottom Tab Bar with Emoji Icons ========== -->
    <TabBar>

        <!-- Home Tab -->
        <Tab Title="Home">
            <Tab.Icon>
                <FontImageSource 
                    Glyph="🏠"
                    FontFamily="Default"
                    Size="24"
                    Color="{DynamicResource TextSecondaryColor}"/>
            </Tab.Icon>
            <ShellContent Route="HomePage" 
                          ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <!-- Favorites Tab -->
        <Tab Title="Favorites">
            <Tab.Icon>
                <FontImageSource 
                    Glyph="❤️"
                    FontFamily="Default"
                    Size="24"
                    Color="{DynamicResource DangerColor}"/>
            </Tab.Icon>
            <ShellContent Route="FavoritesPage" 
                          ContentTemplate="{DataTemplate views:FavoritesPage}" />
        </Tab>

        <!-- Settings Tab -->
        <Tab Title="Settings">
            <Tab.Icon>
                <FontImageSource 
                    Glyph="⚙️"
                    FontFamily="Default"
                    Size="24"
                    Color="{DynamicResource TextSecondaryColor}"/>
            </Tab.Icon>
            <ShellContent Route="SettingsPage" 
                          ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>

    </TabBar>

</Shell>