<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.Controls.LoadingControl">

    <ContentView.Content>
        <Frame BackgroundColor="{DynamicResource CardColor}"
               CornerRadius="16"
               Padding="24"
               HasShadow="True">
            <VerticalStackLayout Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsLoading, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                   Color="{DynamicResource CurrentPrimaryColor}"
                                   WidthRequest="60"
                                   HeightRequest="60"/>
                
                <Label Text="{Binding LoadingText, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextPrimaryColor}"/>
            </VerticalStackLayout>
        </Frame>
    </ContentView.Content>
</ContentView>
